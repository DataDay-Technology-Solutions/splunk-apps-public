          <latest>$time_range.latest$</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
        <format type="color" field="urgency">
          <colorPalette type="map">{"critical":"#d93f3c","high":"#e8833a"}</colorPalette>
        </format>
      </table>
    </panel>
  </row>

  <!-- Incident Review — notable queue (urgency / status / owner) -->
  <row>
    <panel>
      <single>
        <title>Open notables</title>
        <search>
          <query>| `ar_notable_kpi($entity$)` | fields total</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[5,15]</option>
        <option name="useColors">1</option>
        <option name="underLabel">events in the notable queue</option>
