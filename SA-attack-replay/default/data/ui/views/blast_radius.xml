  <!-- HERO — RBA cumulative risk accrual + threshold trip (JS, demo scenario) -->
  <row depends="$mode_demo$">
    <panel>
      <html>
        <div class="ar-rba-panel">
          <div class="ar-rba-head">
            <div class="ar-rba-title">Risk accrual &amp; notable trip <span class="ar-rba-sub">— Risk-Based Alerting, $title_mode$</span></div>
            <button class="ar-rba-replay" type="button">▸ Replay accrual</button>
          </div>
          <div id="ar-rba-root"></div>
          <div class="ar-rba-foot">Each line is a <strong>risk object</strong> (host or user). Risk accrues as correlation searches fire; the moment a line crosses the dashed <strong>notable threshold (100)</strong>, ES raises a <strong>Risk Notable</strong>. Solid = system · dashed = user.</div>
        </div>
      </html>
    </panel>
  </row>

  <!-- RBA risk objects + threshold breaches (SPL, both modes) -->
  <row>
    <panel>
      <table>
        <title>Risk objects by accumulated RBA score — $title_entity$</title>
        <search>
          <query>| `ar_rba_risk_objects($entity$)`</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
        <format type="color" field="status">
          <colorPalette type="map">{"NOTABLE FIRED":"#d93f3c","accruing":"#f8be34"}</colorPalette>
        </format>
        <format type="color" field="total_risk">
          <colorPalette type="minMidMax" maxColor="#d93f3c" midColor="#f8be34" minColor="#5b9f5b"></colorPalette>
          <scale type="minMidMax" minValue="0" midValue="100" maxValue="300"></scale>
        </format>
      </table>
    </panel>
    <panel>
      <table>
        <title>Risk Notables fired — threshold breaches (RBA → Incident Review)</title>
        <search>
          <query>| `ar_rba_breaches($entity$)`</query>
