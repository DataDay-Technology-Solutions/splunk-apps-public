  <!-- ===================================================================== -->
  <row>
    <panel>
      <html>
        <div class="ar-es-banner">
          <div class="ar-es-banner-title">🛡 Enterprise Security — Risk-Based Alerting &amp; Incident Review</div>
          <div class="ar-es-banner-sub">Blast Radius seeds and reads Splunk ES-shaped data (<code>index=risk</code>, <code>index=notable</code>), so this section behaves exactly as it would against a live ES deployment. In <strong>Demo</strong> it visualizes the bundled scenario; switch to <strong>Live</strong> and the same panels read your real RBA risk events and notables.</div>
        </div>
      </html>
    </panel>
